<Window x:Class="Balanced_Gaming.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        Title="BalancedGaming" 
        Height="600" 
        Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#0D1117"
        Loaded="Window_Loaded">

        <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header Section -->
        <Border Grid.Row="0" Background="#2C3E50" Padding="20,0">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="BalancedGaming" FontSize="24" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Healthy Gaming Habits Tracker" FontSize="12" Foreground="#BDC3C7"/>
                </StackPanel>
                <Button Content="Hide to Tray"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Padding="15,5" Click="HideToTray_Click"
                        Background="#34495E" Foreground="White"
                        BorderThickness="0" Cursor="Hand"/>
            </Grid>
        </Border>

        <!-- Tab Control -->
        <TabControl Grid.Row="1" Margin="10" BorderThickness="0" Background="#0D1117">

            <!-- Dashboard Tab -->
            <TabItem Header="Dashboard" FontSize="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#0D1117">
                    <Grid Margin="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Hero Banner -->
                        <Border Grid.Row="0" CornerRadius="10" Padding="24,18" Margin="0,0,0,16">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#0F1E2E" Offset="0"/>
                                    <GradientStop Color="#162032" Offset="0.6"/>
                                    <GradientStop Color="#111A16" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="userWelcomeText" Text="Welcome back!"
                                               FontSize="22" FontWeight="Bold" Foreground="#E6EDF3"/>
                                    <TextBlock x:Name="dbStatusText" Text="Account created: 20.03.2026"
                                               FontSize="12" Foreground="#6B7A8D" Margin="0,4,0,10"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Background="#1A2E1F" CornerRadius="12" Padding="10,4"
                                                Margin="0,0,8,0" BorderBrush="#2D5A3A" BorderThickness="1">
                                            <TextBlock x:Name="dashWeekBadgeText" Text="3h 54m this week"
                                                       FontSize="11" Foreground="#3DDC84"/>
                                        </Border>
                                        <Border x:Name="dashNoSessionBadge" Background="#2E2010"
                                                CornerRadius="12" Padding="10,4"
                                                BorderBrush="#5A3A10" BorderThickness="1">
                                            <TextBlock Text="No session today yet"
                                                       FontSize="11" Foreground="#F0A033"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                                <Button Content="▶  Start Session"
                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Padding="20,10" Click="OpenSessionTracker_Click"
                                        Background="#3DDC84" Foreground="#0D1117"
                                        FontSize="13" FontWeight="Bold"
                                        BorderThickness="0" Cursor="Hand"/>
                            </Grid>
                        </Border>

                        <!-- Stat Cards -->
                        <Grid Grid.Row="1" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Today's Gaming -->
                            <Border Grid.Column="0" Background="#161B22" CornerRadius="10"
                                    Margin="0,0,10,0" Padding="16,14"
                                    BorderBrush="#21262D" BorderThickness="1">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.3" Color="#000000"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="3"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" Background="#4FA8E8" CornerRadius="2,2,0,0" Margin="-16,-14,-16,0"/>
                                    <StackPanel Grid.Row="1" Margin="0,10,0,0">
                                        <TextBlock Text="⏱  Today's Gaming" FontSize="11" Foreground="#6B7A8D" Margin="0,0,0,6"/>
                                        <TextBlock x:Name="dashTodayTimeText" Text="0h 0m"
                                                   FontSize="22" FontWeight="Bold" Foreground="#4FA8E8"/>
                                        <TextBlock x:Name="dashTodayLimitText" Text="0 / 120 min"
                                                   FontSize="11" Foreground="#6B7A8D" Margin="0,5,0,4"/>
                                        <Border Background="#21262D" CornerRadius="3" Height="5">
                                            <Border x:Name="dashLimitProgressBar" Background="#4FA8E8"
                                                    CornerRadius="3" HorizontalAlignment="Left" Width="0"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Today's Sessions -->
                            <Border Grid.Column="1" Background="#161B22" CornerRadius="10"
                                    Margin="0,0,10,0" Padding="16,14"
                                    BorderBrush="#21262D" BorderThickness="1">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.3" Color="#000000"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="3"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" Background="#A78BFA" CornerRadius="2,2,0,0" Margin="-16,-14,-16,0"/>
                                    <StackPanel Grid.Row="1" Margin="0,10,0,0">
                                        <TextBlock Text="🎮  Today's Sessions" FontSize="11" Foreground="#6B7A8D" Margin="0,0,0,6"/>
                                        <TextBlock x:Name="dashTodaySessionsText" Text="0"
                                                   FontSize="22" FontWeight="Bold" Foreground="#A78BFA"/>
                                        <TextBlock x:Name="dashTodayGameText" Text="No sessions yet"
                                                   FontSize="11" Foreground="#6B7A8D" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Mood Change -->
                            <Border Grid.Column="2" Background="#161B22" CornerRadius="10"
                                    Margin="0,0,10,0" Padding="16,14"
                                    BorderBrush="#21262D" BorderThickness="1">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.3" Color="#000000"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="3"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" Background="#3DDC84" CornerRadius="2,2,0,0" Margin="-16,-14,-16,0"/>
                                    <StackPanel Grid.Row="1" Margin="0,10,0,0">
                                        <TextBlock Text="😊  Mood Change" FontSize="11" Foreground="#6B7A8D" Margin="0,0,0,6"/>
                                        <TextBlock x:Name="dashMoodText" Text="N/A"
                                                   FontSize="22" FontWeight="Bold" Foreground="#3DDC84"/>
                                        <TextBlock x:Name="dashMoodLabelText" Text="No mood data"
                                                   FontSize="11" Foreground="#6B7A8D" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- This Week -->
                            <Border Grid.Column="3" Background="#161B22" CornerRadius="10"
                                    Padding="16,14" BorderBrush="#21262D" BorderThickness="1">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.3" Color="#000000"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="3"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" Background="#F0A033" CornerRadius="2,2,0,0" Margin="-16,-14,-16,0"/>
                                    <StackPanel Grid.Row="1" Margin="0,10,0,0">
                                        <TextBlock Text="📅  This Week" FontSize="11" Foreground="#6B7A8D" Margin="0,0,0,6"/>
                                        <TextBlock x:Name="dashWeekTimeText" Text="0h 0m"
                                                   FontSize="22" FontWeight="Bold" Foreground="#F0A033"/>
                                        <TextBlock x:Name="dashWeekSessionsText" Text="0 sessions"
                                                   FontSize="11" Foreground="#6B7A8D" Margin="0,5,0,2"/>
                                        <TextBlock x:Name="dashMostPlayedText" Text=""
                                                   FontSize="11" Foreground="#4FA8E8" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Daily Limit Warning -->
                        <Border x:Name="dashLimitWarning" Grid.Row="2"
                                Background="#2E1A0A" CornerRadius="8" Padding="15"
                                Margin="0,0,0,16" Visibility="Collapsed"
                                BorderBrush="#5A3A10" BorderThickness="1">
                            <TextBlock x:Name="dashLimitWarningText" Text=""
                                       FontSize="13" Foreground="#F0A033" FontWeight="SemiBold"/>
                        </Border>

                        <!-- Charts Row -->
                        <Grid Grid.Row="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Daily Gaming Chart -->
                            <Border Grid.Column="0" Background="#161B22" CornerRadius="10"
                                    Padding="18" Margin="0,0,10,0"
                                    BorderBrush="#21262D" BorderThickness="1">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.3" Color="#000000"/>
                                </Border.Effect>
                                <StackPanel>
                                    <Grid Margin="0,0,0,4">
                                        <StackPanel>
                                            <TextBlock Text="Daily Gaming This Week"
                                                       FontSize="13" FontWeight="Bold" Foreground="#E6EDF3"/>
                                            <TextBlock Text="Minutes played per day — Friday session drove this week's activity."
                                                       FontSize="11" Foreground="#6B7A8D"
                                                       TextWrapping="Wrap" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Background="#1A2E1F" CornerRadius="12" Padding="8,3"
                                                BorderBrush="#2D5A3A" BorderThickness="1">
                                            <TextBlock Text="Fri peak: ~120m" FontSize="10" Foreground="#3DDC84"/>
                                        </Border>
                                    </Grid>
                                    <Border Background="#21262D" Height="1" Margin="0,8,0,12"/>
                                    <lvc:CartesianChart x:Name="dashWeeklyChart" Height="200"/>
                                    <TextBlock Text="← Sun  ·  Mon  ·  Tue  ·  Wed  ·  Thu  ·  Fri  ·  Sat →"
                                               FontSize="10" Foreground="#3D4A5A"
                                               HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Mood Chart -->
                            <Border Grid.Column="1" Background="#161B22" CornerRadius="10"
                                    Padding="18" BorderBrush="#21262D" BorderThickness="1">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.3" Color="#000000"/>
                                </Border.Effect>
                                <StackPanel>
                                    <Grid Margin="0,0,0,4">
                                        <StackPanel>
                                            <TextBlock Text="Mood Before vs After Gaming"
                                                       FontSize="13" FontWeight="Bold" Foreground="#E6EDF3"/>
                                            <TextBlock Text="Tracks how gaming sessions affect your mood. Rising green = positive impact."
                                                       FontSize="11" Foreground="#6B7A8D"
                                                       TextWrapping="Wrap" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Background="#2E2010" CornerRadius="12" Padding="8,3"
                                                BorderBrush="#5A3A10" BorderThickness="1">
                                            <TextBlock Text="1 low mood dip noted" FontSize="10" Foreground="#F0A033"/>
                                        </Border>
                                    </Grid>
                                    <Border Background="#21262D" Height="1" Margin="0,8,0,8"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Ellipse Width="8" Height="8" Fill="#4FA8E8" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Before session" FontSize="11" Foreground="#6B7A8D" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                        <Ellipse Width="8" Height="8" Fill="#3DDC84" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="After session" FontSize="11" Foreground="#6B7A8D" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <lvc:CartesianChart x:Name="dashMoodChart" Height="200"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- Sessions Tab -->
            <TabItem Header="Sessions" FontSize="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#0D1117">
                    <Grid Margin="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,16">
                            <TextBlock Text="Gaming Sessions History"
                                       FontSize="24" FontWeight="Bold" Foreground="#E6EDF3"/>
                            <TextBlock Text="Browse, filter and export your past gaming sessions."
                                       FontSize="12" Foreground="#6B7A8D" Margin="0,4,0,0"/>
                        </StackPanel>

                        <Border Grid.Row="1" Background="#161B22" CornerRadius="10"
                                Padding="16,14" Margin="0,0,0,14"
                                BorderBrush="#21262D" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.3" Color="#000000"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Date Range:" FontSize="12" FontWeight="SemiBold"
                                               Foreground="#6B7A8D" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <DatePicker x:Name="sessionsStartDate" Language="en-GB" Width="130" Margin="0,0,8,0"/>
                                    <TextBlock Text="to" FontSize="12" Foreground="#6B7A8D"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <DatePicker x:Name="sessionsEndDate" Language="en-GB" Width="130"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="12,0,0,0">
                                    <Button Content="Apply Filter" Click="ApplySessionsFilter_Click"
                                            Padding="14,8" Margin="0,0,8,0"
                                            Background="#4FA8E8" Foreground="#0D1117"
                                            FontWeight="Bold" FontSize="12"
                                            BorderThickness="0" Cursor="Hand"/>
                                    <Button Content="Reset" Click="ResetSessionsFilter_Click"
                                            Padding="14,8" Margin="0,0,8,0"
                                            Background="#21262D" Foreground="#6B7A8D"
                                            FontSize="12" BorderThickness="1"
                                            BorderBrush="#30363D" Cursor="Hand"/>
                                    <Button Content="Export to CSV" Click="ExportSessionsCSV_Click"
                                            Padding="14,8"
                                            Background="#3DDC84" Foreground="#0D1117"
                                            FontWeight="Bold" FontSize="12"
                                            BorderThickness="0" Cursor="Hand"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Row="2" Background="#161B22" CornerRadius="10"
                                Padding="0" Margin="0,0,0,14"
                                BorderBrush="#21262D" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.3" Color="#000000"/>
                            </Border.Effect>
                            <DataGrid x:Name="sessionsDataGrid"
                                      AutoGenerateColumns="False" IsReadOnly="True"
                                      Background="Transparent"
                                      RowBackground="#161B22" AlternatingRowBackground="#1C2230"
                                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#21262D"
                                      HeadersVisibility="Column" CanUserResizeRows="False"
                                      BorderThickness="0" Foreground="#E6EDF3" FontSize="13">
                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#0D1117"/>
                                        <Setter Property="Foreground" Value="#6B7A8D"/>
                                        <Setter Property="FontSize" Value="11"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Padding" Value="12,10"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        <Setter Property="BorderBrush" Value="#21262D"/>
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="Foreground" Value="#E6EDF3"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#1F2937"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#1A2E1F"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.CellStyle>
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="Padding" Value="12,8"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Foreground" Value="#E6EDF3"/>
                                    </Style>
                                </DataGrid.CellStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Game" Binding="{Binding GameName}" Width="*" MinWidth="120"/>
                                    <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="120"/>
                                    <DataGridTextColumn Header="Start Time" Binding="{Binding StartTime}" Width="100"/>
                                    <DataGridTextColumn Header="End Time" Binding="{Binding EndTime}" Width="100"/>
                                    <DataGridTextColumn Header="Duration" Binding="{Binding Duration}" Width="100"/>
                                    <DataGridTextColumn Header="Mood Before" Binding="{Binding MoodBefore}" Width="110"/>
                                    <DataGridTextColumn Header="Mood After" Binding="{Binding MoodAfter}" Width="110"/>
                                    <DataGridTextColumn Header="Satisfaction" Binding="{Binding Satisfaction}" Width="110"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <Border Grid.Row="3" Background="#161B22" CornerRadius="10"
                                Padding="16,12" BorderBrush="#21262D" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <Border Background="#1A2E1F" CornerRadius="6" Padding="10,4"
                                        Margin="0,0,10,0" BorderBrush="#2D5A3A" BorderThickness="1">
                                    <TextBlock x:Name="sessionsCountText" Text="Showing 0 sessions"
                                               FontSize="12" FontWeight="Bold" Foreground="#3DDC84"/>
                                </Border>
                                <Border Background="#21262D" CornerRadius="6" Padding="10,4"
                                        BorderBrush="#30363D" BorderThickness="1">
                                    <TextBlock x:Name="sessionsTotalTimeText" Text="Total: 0h 0m"
                                               FontSize="12" Foreground="#6B7A8D"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- Steam Library Tab -->
            <TabItem Header="Steam Library" FontSize="14">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="🎮 Your Steam Library"
                               FontSize="28" FontWeight="Bold"
                               Foreground="#E6EDF3" Margin="0,0,0,20"/>
                    <Border Grid.Row="1" Background="#161B22" CornerRadius="8"
                            Padding="15" Margin="0,0,0,20"
                            BorderBrush="#30363D" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Steam credentials" FontSize="14" FontWeight="Bold"
                                       Foreground="#E6EDF3" Margin="0,0,0,10"/>

                            <TextBlock Text="API Key" Foreground="#6B7A8D" FontSize="12"/>
                            <PasswordBox x:Name="steamApiKeyBox" Height="28" Margin="0,2,0,10"
                                         Background="#0D1117" Foreground="#E6EDF3" BorderBrush="#30363D"/>

                            <TextBlock Text="Steam ID (64-bit)" Foreground="#6B7A8D" FontSize="12"/>
                            <TextBox x:Name="steamIdBox" Height="28" Margin="0,2,0,10"
                                     Background="#0D1117" Foreground="#E6EDF3" BorderBrush="#30363D"/>

                            <StackPanel Orientation="Horizontal">
                                <Button Content="Save" Width="100" Height="30"
                                        Click="SaveSteamSettings_Click"
                                        Background="#3498DB" Foreground="White" Cursor="Hand"/>
                                <TextBlock x:Name="steamSettingsStatus" Margin="15,0,0,0"
                                           VerticalAlignment="Center" Foreground="#6B7A8D" FontSize="12"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    
                    <Button Grid.Row="2" x:Name="LoadGamesButton"
                            Content="Load My Steam Games"
                            Width="200" Height="40" HorizontalAlignment="Left"
                            Click="LoadGamesButton_Click"
                            Background="#4CAF50" Foreground="White"
                            FontSize="14" Cursor="Hand" Margin="0,0,0,20"/>

                    <Button Grid.Row="2" Content="Import to My Games"
                            Width="180" Height="40" HorizontalAlignment="Left"
                            Margin="220,0,0,20" Click="ImportSteamGames_Click"
                            Background="#3498DB" Foreground="White"
                            FontSize="14" Cursor="Hand"/>

                    <Border Grid.Row="3" Background="White" CornerRadius="8" Padding="20">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1"/>
                        </Border.Effect>
                        <ListView x:Name="GamesListView" MouseDoubleClick="GamesListView_DoubleClick"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto" BorderThickness="0">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Game Name" Width="400">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}" FontSize="14"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="App ID" Width="100">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding AppId}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Playtime (hours)" Width="150">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding PlaytimeHours}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Reminders Tab -->
            <TabItem Header="Reminders" FontSize="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#0D1117">
                    <Grid Margin="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,16">
                            <TextBlock Text="Break Reminders"
                                       FontSize="24" FontWeight="Bold" Foreground="#E6EDF3"/>
                            <TextBlock Text="Configure when and how often you get reminded to take a break."
                                       FontSize="12" Foreground="#6B7A8D" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- Global Toggle -->
                        <Border Grid.Row="1" Background="#161B22" CornerRadius="10"
                                Padding="20" Margin="0,0,0,14"
                                BorderBrush="#21262D" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.3" Color="#000000"/>
                            </Border.Effect>
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="Enable Break Reminders"
                                               FontSize="15" FontWeight="Bold" Foreground="#E6EDF3"/>
                                    <TextBlock Text="When enabled, you'll receive a Windows notification reminding you to take a break."
                                               FontSize="13" Foreground="#6B7A8D" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <CheckBox x:Name="reminderEnabledToggle"
                                          HorizontalAlignment="Right" VerticalAlignment="Center"
                                          IsChecked="True"
                                          Checked="ReminderSettings_Changed"
                                          Unchecked="ReminderSettings_Changed"/>
                            </Grid>
                        </Border>

                        <!-- Interval Settings -->
                        <Border Grid.Row="2" Background="#161B22" CornerRadius="10"
                                Padding="20" Margin="0,0,0,14"
                                BorderBrush="#21262D" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.3" Color="#000000"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="Reminder Interval"
                                           FontSize="15" FontWeight="Bold" Foreground="#E6EDF3" Margin="0,0,0,4"/>
                                <TextBlock Text="How often should we remind you to take a break during a session?"
                                           FontSize="13" Foreground="#6B7A8D" Margin="0,0,0,16" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <Button x:Name="interval10Btn" Content="10 min"
                                            Click="IntervalPreset_Click" Tag="10"
                                            Padding="16,8" Margin="0,0,8,0"
                                            Background="#21262D" Foreground="#6B7A8D"
                                            BorderBrush="#30363D" BorderThickness="1" Cursor="Hand"/>
                                    <Button x:Name="interval30Btn" Content="30 min"
                                            Click="IntervalPreset_Click" Tag="30"
                                            Padding="16,8" Margin="0,0,8,0"
                                            Background="#1A2E1F" Foreground="#3DDC84"
                                            BorderBrush="#2D5A3A" BorderThickness="1" Cursor="Hand"/>
                                    <Button x:Name="interval60Btn" Content="1 hour"
                                            Click="IntervalPreset_Click" Tag="60"
                                            Padding="16,8" Margin="0,0,8,0"
                                            Background="#21262D" Foreground="#6B7A8D"
                                            BorderBrush="#30363D" BorderThickness="1" Cursor="Hand"/>
                                    <Button x:Name="interval90Btn" Content="90 min"
                                            Click="IntervalPreset_Click" Tag="90"
                                            Padding="16,8" Margin="0,0,16,0"
                                            Background="#21262D" Foreground="#6B7A8D"
                                            BorderBrush="#30363D" BorderThickness="1" Cursor="Hand"/>
                                    <TextBlock Text="Custom:" FontSize="12" Foreground="#6B7A8D"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox x:Name="customIntervalBox" Width="60" Padding="8,6"
                                             Background="#21262D" Foreground="#E6EDF3"
                                             BorderBrush="#30363D" BorderThickness="1"
                                             Text="30" TextChanged="CustomInterval_Changed"/>
                                    <TextBlock Text="min" FontSize="12" Foreground="#6B7A8D"
                                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </StackPanel>
                                <Border Background="#21262D" Height="1" Margin="0,0,0,16"/>
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="#1A2E1F" CornerRadius="6" Padding="10,4"
                                            BorderBrush="#2D5A3A" BorderThickness="1">
                                        <TextBlock x:Name="currentIntervalText"
                                                   Text="Reminder every 30 minutes"
                                                   FontSize="12" Foreground="#3DDC84"/>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Game Exceptions -->
                        <Border Grid.Row="3" Background="#161B22" CornerRadius="10"
                                Padding="20" BorderBrush="#21262D" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.3" Color="#000000"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="Game Exceptions"
                                           FontSize="15" FontWeight="Bold" Foreground="#E6EDF3" Margin="0,0,0,4"/>
                                <TextBlock Text="Reminders will be disabled for these games."
                                           FontSize="13" Foreground="#6B7A8D" Margin="0,0,0,16" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <ComboBox x:Name="exceptionGamePicker" Width="220" Margin="0,0,10,0"
                                              BorderBrush="#30363D" BorderThickness="1" FontSize="13">
                                        <ComboBox.ItemContainerStyle>
                                            <Style TargetType="ComboBoxItem">
                                                <Setter Property="Background" Value="#161B22"/>
                                                <Setter Property="Foreground" Value="#E6EDF3"/>
                                                <Setter Property="FontSize" Value="13"/>
                                                <Setter Property="Padding" Value="12,9"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#1A2E1F"/>
                                                        <Setter Property="Foreground" Value="#3DDC84"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter Property="Background" Value="#1A2E1F"/>
                                                        <Setter Property="Foreground" Value="#3DDC84"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ComboBox.ItemContainerStyle>
                                    </ComboBox>
                                    <Button Content="+ Add Exception" Click="AddGameException_Click"
                                            Padding="14,8"
                                            Background="#4FA8E8" Foreground="#0D1117"
                                            FontWeight="Bold" FontSize="12"
                                            BorderThickness="0" Cursor="Hand"/>
                                </StackPanel>
                                <Border Background="#21262D" Height="1" Margin="0,0,0,14"/>
                                <ListBox x:Name="exceptionsListBox"
                                         Background="Transparent" BorderThickness="0" Foreground="#E6EDF3">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding GameName}"
                                                           FontSize="13" Foreground="#E6EDF3"
                                                           VerticalAlignment="Center"/>
                                                <Button Grid.Column="1" Content="Remove"
                                                        Tag="{Binding GameId}"
                                                        Click="RemoveGameException_Click"
                                                        Padding="10,4"
                                                        Background="#2E1A0A" Foreground="#F0A033"
                                                        BorderBrush="#5A3A10" BorderThickness="1"
                                                        FontSize="11" Cursor="Hand"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock x:Name="noExceptionsText"
                                           Text="No exceptions added — reminders apply to all games."
                                           FontSize="11" Foreground="#6B7A8D" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </Grid>
</Window>