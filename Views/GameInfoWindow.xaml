<Window x:Class="Balanced_Gaming.GameInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Game Info" Height="500" Width="600"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock x:Name="gameTitleText"
                   Grid.Row="0"
                   FontSize="24"
                   FontWeight="Bold"
                   Foreground="#2C3E50"
                   Margin="0,0,0,20"
                   TextWrapping="Wrap"/>

        <!-- Details -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,15">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Developer" FontSize="12" Foreground="#7F8C8D" Margin="0,0,0,5"/>
                        <TextBlock x:Name="developerText" FontSize="14" Foreground="#2C3E50" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,15">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Genre" FontSize="12" Foreground="#7F8C8D" Margin="0,0,0,5"/>
                        <TextBlock x:Name="genreText" FontSize="14" Foreground="#2C3E50" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,15">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Release Date" FontSize="12" Foreground="#7F8C8D" Margin="0,0,0,5"/>
                        <TextBlock x:Name="releaseDateText" FontSize="14" Foreground="#2C3E50"/>
                    </StackPanel>
                </Border>
                <Border Background="White" CornerRadius="8" Padding="20">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Description" FontSize="12" Foreground="#7F8C8D" Margin="0,0,0,5"/>
                        <TextBlock x:Name="descriptionText" FontSize="14" Foreground="#2C3E50" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Close Button -->
        <Button Grid.Row="2"
                Content="Close"
                Width="100"
                Height="35"
                HorizontalAlignment="Right"
                Margin="0,15,0,0"
                Click="Close_Click"
                Background="#95A5A6"
                Foreground="White"
                BorderThickness="0"
                Cursor="Hand"/>
    </Grid>
</Window>